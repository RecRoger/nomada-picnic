{
  "name": "nomada-picnic",
  "private": true,
  "description": "Monorepo para Nómada Picnic",
  "workspaces": [
    "api",
    "client"
  ],
  "scripts": {
    "install:all": "npm install",
    "start:client": "npm run start --workspace=client",
    "start:dev": "npm run start:dev --workspace=api",
    "dev": "concurrently \"npm run start:dev\" \"npm run start:client\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
