# ETAPA 1: Construcción
FROM node:20-alpine AS builder
WORKDIR /app

# Copiamos archivos de dependencias de la raíz y de la API
COPY package*.json ./
COPY api/package*.json ./api/

# Instalamos todas las dependencias
RUN npm install

# Copiamos el código fuente
COPY shared/ ./shared/
COPY api/ ./api/

# Compilamos la API
WORKDIR /app/api
RUN npm run build

# ETAPA 2: Ejecución
FROM node:20-alpine
WORKDIR /app/api

# Copiamos el package.json de la API y sus archivos compilados
COPY package*.json ./
COPY api/package*.json ./api/

# Copiamos todo el directorio dist generado
COPY --from=builder /app/api/dist ./dist
# Copiamos los node_modules
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/api/node_modules ./node_modules

ENV PORT=8080
EXPOSE 8080

# ⚠️ Asegúrate de incluir la extensión .js y verificar la ruta del entrypoint
CMD ["node", "dist/api/src/main.js"]