{
  "name": "nomada-picnic",
  "private": true,
  "description": "Monorepo para Nómada Picnic",
  "workspaces": [
    "api",
    "client"
  ],
  "scripts": {
    "install:all": "npm install --legacy-peer-deps",
    "start:client": "npm run start --workspace=client",
    "start:api": "npm run start:dev --workspace=api",
    "start:debug": "npm run start:debug --workspace=api",
    "build:api": "npm run build --workspace=api",
    "deploy:api": "bash deploy.sh api",
    "deploy:client": "bash deploy.sh client",
    "deploy:all": "npm run deploy:api && npm run deploy:client",
    "dev": "concurrently \"npm run start:dev\" \"npm run start:client\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
