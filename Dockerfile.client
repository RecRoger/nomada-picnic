# ETAPA 1: Construcción (Build)
FROM node:20-alpine AS builder
WORKDIR /app

# Copiamos manifiestos de la raíz y subcarpetas
COPY package*.json ./
COPY client/package*.json ./client/

# Instalamos dependencias unificadas
RUN npm install

# Copiamos el código fuente (incluyendo shared si aplica)
COPY shared/ ./shared/
COPY client/ ./client/

# Compilamos Angular SSR en modo producción
WORKDIR /app/client
RUN npm run build -- --configuration production

# ETAPA 2: Servidor de Producción (Node.js)
FROM node:20-alpine AS runner
WORKDIR /app

# Variable de entorno para Cloud Run (escucha en el puerto configurado)
ENV PORT=8080
ENV NODE_ENV=production

# Copiamos la compilación generada por Angular SSR
# Angular 19 genera las carpetas 'browser' y 'server' dentro de dist/client
COPY --from=builder /app/client/dist/client ./dist/client

# Opcional: Copiamos package.json por si tu server.mjs requiere dependencias externas
COPY --from=builder /app/package*.json ./

EXPOSE 8080

# Iniciamos el servidor Node.js que renderiza el SSR
CMD ["node", "dist/client/server/server.mjs"]