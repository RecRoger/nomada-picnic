{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "manualRestart": true,
    "plugins": ["@nestjs/swagger"],
    "assets": [
      {
        "include": "modules/mails/templates/**/*.hbs",
        "outDir": "dist/api/src",
        "watchAssets": true
      }
    ]
  }
}
