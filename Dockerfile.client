# ETAPA 1: Construcción (Build)
FROM node:20-alpine AS builder
WORKDIR /app

# Copiamos manifiestos e instalamos todas las dependencias
COPY package*.json ./
COPY client/package*.json ./client/
RUN npm install

# Copiamos código fuente y compilamos Angular SSR
COPY shared/ ./shared/
COPY client/ ./client/

WORKDIR /app/client
RUN npm run build -- --configuration production

# ETAPA 2: Servidor de Producción (Node.js)
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8080

# Copiamos manifiestos de dependencias
COPY package*.json ./
COPY client/package*.json ./client/

# Instalamos SOLO dependencias de producción en la etapa final
WORKDIR /app/client
RUN npm ci --omit=dev

# Copiamos la carpeta compilada desde builder
COPY --from=builder /app/client/dist/client ./dist/client

# Exponemos el puerto
EXPOSE 8080

# Ejecutamos el servidor SSR de Angular
CMD ["node", "dist/client/server/server.mjs"]